{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://network-bridge.local/config.schema.json",
  "title": "network bridge 框架配置",
  "description": "nb_config_parse 和 nb_config_parse_file 接受的 JSON 配置。字符串枚举为小写且区分大小写。未知字段会被忽略（nb_config_parse 会打印警告）。",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "maxLength": 63,
      "description": "Node 名称。默认：nb。"
    },
    "mode": {
      "type": "string",
      "enum": ["mesh", "static"],
      "description": "发现模式。默认：mesh。static 等价于 discovery.disable=true。"
    },
    "runtime": {
      "type": "object",
      "properties": {
        "io_threads": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8,
          "description": "poller 线程数。0 表示硬件并发数；超过 NB_TRANSPORT_MAX_IO（8）会被拒绝。"
        },
        "handler_threads": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1024,
          "description": "worker 线程数。0 关闭 worker 线程池。"
        },
        "handler_max_concurrency": {
          "type": "integer",
          "minimum": 0,
          "description": "排队中加执行中的 worker/executor 任务上限。0 表示不限制。"
        },
        "max_inflight": {
          "type": "integer",
          "minimum": 0,
          "description": "客户端在途调用上限。0 表示默认值 65536。"
        },
        "max_streams": {
          "type": "integer",
          "minimum": 0,
          "maximum": 64,
          "description": "并发入站流上限。0 表示默认值 64。"
        },
        "peer_rate_limit_pps": {
          "type": "integer",
          "minimum": 0,
          "description": "每个对端的入站请求每秒上限。0 表示不限制。"
        },
        "send_lanes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 64,
          "description": "专用发送 lane 的 poller 线程，与负责接收和分发的 io poller 隔离。通过 nb_node_post_send 运行发布循环，使 nb_proxy_call_event 走内联发送快路径。0 关闭。"
        }
      },
      "additionalProperties": true
    },
    "transport": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["udp", "tcp"],
          "description": "未显式配置 bindings 时使用的默认传输。默认：udp。"
        },
        "bind_host": {
          "type": "string",
          "maxLength": 63,
          "description": "默认绑定地址。默认：0.0.0.0。"
        },
        "data_port": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535,
          "description": "默认数据端口。0 表示由操作系统选择。"
        },
        "bindings": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "oneOf": [
              {
                "type": "string",
                "maxLength": 255,
                "description": "端点 URI，例如 tcp://127.0.0.1:42420。"
              },
              {
                "type": "object",
                "required": ["endpoint"],
                "properties": {
                  "name": {
                    "type": "string",
                    "maxLength": 15
                  },
                  "endpoint": {
                    "type": "string",
                    "maxLength": 255
                  },
                  "intra_process": {
                    "type": "string",
                    "enum": ["off", "auto", "only"],
                    "description": "DDS 事件的进程内快路径。"
                  },
                  "poll_us": {
                    "type": "integer",
                    "minimum": 0,
                    "description": "shm 排空本地队列后的忙轮询窗口（微秒），超时后回退到阻塞等待。0 表示阻塞等待唤醒。"
                  },
                  "qos": {
                    "$ref": "#/$defs/qos"
                  }
                },
                "additionalProperties": true
              }
            ]
          },
          "description": "显式监听端点。"
        },
        "frag_bytes": {
          "type": "integer",
          "anyOf": [
            { "const": 0 },
            { "minimum": 256, "maximum": 8192 }
          ],
          "description": "UDP 分片大小。0 使用默认值 1440（IPv4 1500 MTU 减去 60 字节头部）；否则为 256..8192。"
        },
        "max_msg_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 67108864,
          "description": "信封最大长度。默认 1 MiB；最大 64 MiB。"
        },
        "backpressure_bytes": {
          "type": "integer",
          "minimum": 0,
          "description": "出站高水位。默认 4 MiB。"
        },
        "rtcp_interval_ms": {
          "type": "integer",
          "minimum": 0,
          "description": "UDP RTCP 报告间隔。默认 1000 ms。"
        },
        "disable_rtcp": {
          "type": "boolean",
          "description": "设为 true 关闭 RTCP。"
        },
        "qos": {
          "$ref": "#/$defs/qos"
        }
      },
      "additionalProperties": true
    },
    "discovery": {
      "type": "object",
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["mesh", "static", "off", "none"],
          "description": "mesh 启用发现；static/off/none 关闭。顶层 mode 为 static 时始终关闭发现。"
        },
        "broadcast": {
          "type": "string",
          "description": "发现地址 host:port。默认 255.255.255.255:41953。"
        },
        "peers": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "string",
            "description": "单播 HELLO 目标，host:port 形式。"
          }
        },
        "hello_interval_ms": {
          "type": "integer",
          "minimum": 0,
          "description": "HELLO 间隔。默认 3000 ms。"
        },
        "node_ttl_ms": {
          "type": "integer",
          "minimum": 0,
          "description": "对端过期时间。默认 9000 ms。"
        }
      },
      "additionalProperties": true
    },
    "metrics": {
      "type": "object",
      "properties": {
        "disable": {
          "type": "boolean",
          "description": "关闭所有指标采集。"
        },
        "disable_latency_histogram": {
          "type": "boolean",
          "description": "只关闭延迟直方图。"
        },
        "sample_every": {
          "type": "integer",
          "minimum": 0,
          "description": "延迟采样间隔。0 或 1 表示每次调用都采样。"
        }
      },
      "additionalProperties": true
    },
    "log": {
      "type": "object",
      "properties": {
        "disable": {
          "type": "boolean",
          "description": "关闭日志输出。"
        },
        "level": {
          "type": "string",
          "enum": ["assert", "error", "warn", "info", "debug", "verbose"],
          "description": "日志级别。默认：info。"
        }
      },
      "additionalProperties": true
    },
    "routes": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "required": ["service", "endpoint"],
        "properties": {
          "service": {
            "type": "string",
            "maxLength": 63
          },
          "endpoint": {
            "type": "string",
            "maxLength": 255,
            "description": "端点 URI，例如 tcp://127.0.0.1:42420。"
          }
        },
        "additionalProperties": true
      },
      "description": "绕过发现流程的静态服务路由。"
    }
  },
  "$defs": {
    "qos": {
      "type": "object",
      "properties": {
        "reliability": {
          "type": "string",
          "enum": ["best_effort", "reliable"],
          "description": "DDS ReliabilityQosPolicy。"
        },
        "durability": {
          "type": "string",
          "enum": ["volatile", "transient_local"],
          "description": "DDS DurabilityQosPolicy。"
        },
        "history": {
          "type": "string",
          "enum": ["keep_last", "keep_all"],
          "description": "DDS HistoryQosPolicy。"
        },
        "depth": {
          "type": "integer",
          "minimum": 0,
          "description": "keep_last 的 history 深度。0 使用 provider 默认值。"
        },
        "deadline_ms": {
          "type": "integer",
          "minimum": 0,
          "description": "DDS DeadlineQosPolicy，单位毫秒。"
        },
        "lifespan_ms": {
          "type": "integer",
          "minimum": 0,
          "description": "DDS LifespanQosPolicy，单位毫秒。"
        },
        "lease_duration_ms": {
          "type": "integer",
          "minimum": 0,
          "description": "DDS LivelinessQosPolicy 的租约时长，单位毫秒。"
        },
        "latency_budget_ms": {
          "type": "integer",
          "minimum": 0,
          "description": "DDS LatencyBudgetQosPolicy，单位毫秒。"
        },
        "min_separation_ms": {
          "type": "integer",
          "minimum": 0,
          "description": "DDS TimeBasedFilterQosPolicy 的最小间隔，单位毫秒；订阅端会丢弃间隔更近的样本。"
        },
        "max_samples": {
          "type": "integer",
          "minimum": 0,
          "description": "DDS ResourceLimitsQosPolicy 的 max_samples；0 表示不限制。"
        },
        "max_instances": {
          "type": "integer",
          "minimum": 0,
          "description": "DDS ResourceLimitsQosPolicy 的 max_instances；0 表示内建上限。订阅端会拒绝会创建更多实例的样本。"
        },
        "max_samples_per_instance": {
          "type": "integer",
          "minimum": 0,
          "description": "DDS ResourceLimitsQosPolicy 的 max_samples_per_instance；0 表示不限制。"
        },
        "autodispose_unregistered_instances": {
          "type": "boolean",
          "description": "DDS WriterDataLifecycleQosPolicy；writer 注销时 dispose 其所有实例。"
        },
        "liveliness": {
          "type": "string",
          "enum": ["automatic", "manual_by_participant", "manual_by_topic"],
          "description": "DDS LivelinessQosPolicy 类型。"
        },
        "ownership": {
          "type": "string",
          "enum": ["shared", "exclusive"],
          "description": "DDS OwnershipQosPolicy。"
        },
        "presentation_scope": {
          "type": "string",
          "enum": ["instance", "topic", "group"],
          "description": "DDS PresentationQosPolicy 访问范围；reader 要求的范围比 writer 提供的更宽时不匹配。"
        },
        "coherent_access": {
          "type": "boolean",
          "description": "DDS PresentationQosPolicy coherent_access；会通告并检查兼容性。"
        },
        "ordered_access": {
          "type": "boolean",
          "description": "DDS PresentationQosPolicy ordered_access；会通告并检查兼容性。"
        },
        "partition": {
          "type": "string",
          "maxLength": 127,
          "description": "DDS PartitionQosPolicy（单个 partition 名称）。"
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
