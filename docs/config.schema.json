{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://network-bridge.local/config.schema.json",
  "title": "network bridge 配置",
  "description": "nb_rpc_config_parse / nb_dds_config_parse 接受的 JSON。两个主干各自解析自己的块：rpc 与 dds 互不依赖，同一个文件可以同时包含两块。字符串枚举小写且区分大小写；时长写数字（毫秒）或 \"250ms\" / \"2s\"。",
  "type": "object",
  "properties": {
    "$schema": { "type": "string" },
    "name": {
      "type": "string",
      "maxLength": 63,
      "description": "进程名；RPC node 和 DDS participant 都使用。默认：nb。"
    },
    "threads": {
      "type": "object",
      "properties": {
        "io": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8,
          "description": "RPC poller 线程数。0 表示硬件并发数。"
        },
        "handlers": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1024,
          "description": "RPC worker 线程数。0 关闭线程池。"
        },
        "send_lanes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 64,
          "description": "RPC 专用发送 lane 线程数。"
        }
      },
      "additionalProperties": true
    },
    "limits": {
      "type": "object",
      "properties": {
        "max_inflight": {
          "type": "integer",
          "minimum": 0,
          "description": "客户端在途调用上限。默认 65536。"
        },
        "max_streams": {
          "type": "integer",
          "minimum": 0,
          "maximum": 64,
          "description": "并发入站流上限。默认 64。"
        },
        "handler_queue": {
          "type": "integer",
          "minimum": 0,
          "description": "未完成的 worker/executor 任务上限。0 表示不限制。"
        },
        "peer_rate_per_second": {
          "type": "integer",
          "minimum": 0,
          "description": "每个对端的入站请求速率上限。0 表示不限制。"
        }
      },
      "additionalProperties": true
    },
    "rpc": {
      "type": "object",
      "description": "RPC 主干：node/service/proxy，传输可选 tcp/udp/shm。",
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["mesh", "static"],
          "description": "服务发现模式。默认 mesh；static 关闭 ntk_discovery。"
        },
        "listen": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "string",
            "maxLength": 255,
            "description": "监听端点 URI，scheme 选择传输：tcp://、udp://、shm://。"
          },
          "description": "RPC 传输列表。客户端也需要至少一个端点用于出站。最多 8 个。"
        },
        "max_message_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 67108864,
          "description": "单条 RPC 消息上限。默认 1 MiB。"
        },
        "backpressure_bytes": {
          "type": "integer",
          "minimum": 0,
          "description": "出站高水位。默认 4 MiB。"
        },
        "udp": {
          "type": "object",
          "properties": {
            "fragment_bytes": {
              "type": "integer",
              "anyOf": [{ "const": 0 }, { "minimum": 256, "maximum": 8192 }],
              "description": "UDP 分片大小。0 使用默认值 1440。"
            },
            "rtcp_interval": {
              "$ref": "#/$defs/duration",
              "description": "RTCP 报告间隔。默认 1s。"
            },
            "rtcp": {
              "type": "boolean",
              "description": "false 关闭 RTCP。默认 true。"
            }
          },
          "additionalProperties": true
        },
        "discovery": {
          "type": "object",
          "properties": {
            "broadcast": {
              "type": "string",
              "description": "发现地址 host:port。默认 255.255.255.255:41953。"
            },
            "peers": {
              "type": "array",
              "maxItems": 32,
              "items": { "type": "string", "description": "单播 HELLO 目标 host:port。" }
            },
            "hello_interval": {
              "$ref": "#/$defs/duration",
              "description": "HELLO 间隔。默认 3s。"
            },
            "node_ttl": {
              "$ref": "#/$defs/duration",
              "description": "对端过期时间。默认 9s。"
            }
          },
          "additionalProperties": true
        },
        "routes": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "object",
            "required": ["service", "endpoint"],
            "properties": {
              "service": { "type": "string", "maxLength": 63 },
              "endpoint": {
                "type": "string",
                "maxLength": 255,
                "description": "端点 URI，例如 tcp://127.0.0.1:42420。"
              }
            },
            "additionalProperties": true
          },
          "description": "静态服务路由；优先于发现结果。"
        }
      },
      "additionalProperties": true
    },
    "dds": {
      "type": "object",
      "description": "DDS 主干：participant/topic/writer/reader，后端 rtps 或 cyclone。不依赖 RPC node。",
      "properties": {
        "backend": {
          "type": "string",
          "enum": ["rtps", "cyclone"],
          "description": "DDS 后端。默认 rtps；cyclone 需要 NB_ENABLE_DDS=ON。"
        },
        "domain": {
          "type": "integer",
          "minimum": 0,
          "description": "DDS domain id。默认 0。"
        },
        "partition": {
          "type": "string",
          "maxLength": 127,
          "description": "DDS partition。作为默认 QoS 继承到 topic/endpoint。"
        },
        "prefix": {
          "type": "string",
          "maxLength": 127,
          "description": "topic 名前缀；线上名 = prefix/name。"
        },
        "name": {
          "type": "string",
          "maxLength": 63,
          "description": "participant 名称。默认取顶层 name。"
        },
        "qos": { "$ref": "#/$defs/qos" },
        "rtps": {
          "type": "object",
          "properties": {
            "bind_host": { "type": "string", "maxLength": 63 },
            "advertise_host": { "type": "string", "maxLength": 63 },
            "multicast_group": {
              "type": "string",
              "maxLength": 63,
              "description": "SPDP 组播地址；空字符串关闭组播。"
            },
            "spdp_port": { "type": "integer", "minimum": 0, "maximum": 65535 },
            "unicast_port": { "type": "integer", "minimum": 0, "maximum": 65535 },
            "announce_interval": { "$ref": "#/$defs/duration" },
            "lease": { "$ref": "#/$defs/duration" },
            "data_heartbeat": { "$ref": "#/$defs/duration" },
            "data_history_depth": { "type": "integer", "minimum": 0 },
            "tcp": { "type": "boolean", "description": "启用 RTPS over TCP。" },
            "tcp_port": { "type": "integer", "minimum": 0, "maximum": 65535 },
            "standard_ports": { "type": "boolean" },
            "participant_id": { "type": "integer", "minimum": 0 },
            "peers": {
              "type": "array",
              "maxItems": 32,
              "items": { "type": "string", "description": "单播 SPDP 目标 host:port。" }
            }
          },
          "additionalProperties": true
        },
        "cyclone": {
          "type": "object",
          "properties": {
            "config_xml": { "type": "string", "maxLength": 511 }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "metrics": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean", "description": "是否采集 RPC 指标。默认 true。" },
        "latency_histogram": { "type": "boolean", "description": "是否采集延迟直方图。默认 true。" },
        "sample_every": { "type": "integer", "minimum": 0, "description": "延迟采样间隔。0/1 表示全采样。" }
      },
      "additionalProperties": true
    },
    "log": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean", "description": "是否输出日志。默认 true。" },
        "level": {
          "type": "string",
          "enum": ["assert", "error", "warn", "info", "debug", "verbose"],
          "description": "日志级别。默认 info。"
        }
      },
      "additionalProperties": true
    }
  },
  "$defs": {
    "duration": {
      "oneOf": [
        { "type": "integer", "minimum": 0, "description": "毫秒数。" },
        { "type": "string", "pattern": "^[0-9]+(ms|s)$", "description": "带单位的时长。" }
      ]
    },
    "qos": {
      "type": "object",
      "description": "DDS QoS。缺省字段继承 participant 默认值；两个后端使用同一套 DDS 默认（best_effort / volatile / keep_last 1）。",
      "properties": {
        "reliability": { "type": "string", "enum": ["best_effort", "reliable"] },
        "durability": { "type": "string", "enum": ["volatile", "transient_local"] },
        "history": { "type": "string", "enum": ["keep_last", "keep_all"] },
        "depth": { "type": "integer", "minimum": 0, "description": "keep_last 深度。" },
        "deadline": { "$ref": "#/$defs/duration" },
        "lifespan": { "$ref": "#/$defs/duration" },
        "latency_budget": { "$ref": "#/$defs/duration" },
        "min_separation": { "$ref": "#/$defs/duration", "description": "DDS TimeBasedFilter 最小间隔。" },
        "liveliness": {
          "type": "string",
          "enum": ["automatic", "manual_by_participant", "manual_by_topic"]
        },
        "lease_duration": { "$ref": "#/$defs/duration" },
        "ownership": { "type": "string", "enum": ["shared", "exclusive"] },
        "partition": { "type": "string", "maxLength": 127 },
        "max_samples": { "type": "integer", "minimum": 0 },
        "max_instances": { "type": "integer", "minimum": 0 },
        "max_samples_per_instance": { "type": "integer", "minimum": 0 },
        "autodispose_unregistered": { "type": "boolean" },
        "presentation_scope": { "type": "string", "enum": ["instance", "topic", "group"] },
        "coherent_access": { "type": "boolean" },
        "ordered_access": { "type": "boolean" }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
