{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://network-bridge.local/config.schema.json",
  "title": "network bridge 框架配置",
  "description": "nb_config_parse 和 nb_config_parse_file 接受的 JSON 配置。字段按用法分组；字符串枚举为小写且区分大小写；时长写数字（毫秒）或 \"250ms\" / \"2s\"。未知字段会被忽略（nb_config_parse 会打印警告）。",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "maxLength": 63,
      "description": "Node 名称。默认：nb。"
    },
    "threads": {
      "type": "object",
      "properties": {
        "io": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8,
          "description": "poller 线程数。0 表示硬件并发数。"
        },
        "handlers": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1024,
          "description": "worker 线程数。0 关闭 worker 线程池。"
        },
        "send_lanes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 64,
          "description": "专用发送 lane 的 poller 线程，与接收/分发 poller 隔离。"
        }
      },
      "additionalProperties": true
    },
    "limits": {
      "type": "object",
      "properties": {
        "max_inflight": {
          "type": "integer",
          "minimum": 0,
          "description": "客户端在途调用上限。默认 65536。"
        },
        "max_streams": {
          "type": "integer",
          "minimum": 0,
          "maximum": 64,
          "description": "并发入站流上限。默认 64。"
        },
        "handler_queue": {
          "type": "integer",
          "minimum": 0,
          "description": "未完成的 worker/executor 任务上限。0 表示不限制。"
        },
        "peer_rate_per_second": {
          "type": "integer",
          "minimum": 0,
          "description": "每个对端的入站请求速率上限。0 表示不限制。"
        }
      },
      "additionalProperties": true
    },
    "rpc": {
      "type": "object",
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["mesh", "static"],
          "description": "服务发现模式。默认：mesh。static 关闭发现。"
        },
        "listen": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "string",
            "maxLength": 255,
            "description": "监听端点 URI，例如 tcp://0.0.0.0:42420。"
          },
          "description": "RPC 监听端点。同一个 URI 也出现在 pubsub.backends 时，两个面共用一个传输。"
        },
        "max_message_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 67108864,
          "description": "单条消息上限。默认 1 MiB。"
        },
        "backpressure_bytes": {
          "type": "integer",
          "minimum": 0,
          "description": "出站高水位。默认 4 MiB。"
        },
        "udp": {
          "type": "object",
          "properties": {
            "fragment_bytes": {
              "type": "integer",
              "anyOf": [
                { "const": 0 },
                { "minimum": 256, "maximum": 8192 }
              ],
              "description": "UDP 分片大小。0 使用默认值 1440。"
            },
            "rtcp_interval": {
              "$ref": "#/$defs/duration",
              "description": "RTCP 报告间隔。默认 1s。"
            },
            "rtcp": {
              "type": "boolean",
              "description": "false 关闭 RTCP。默认 true。"
            }
          },
          "additionalProperties": true
        },
        "discovery": {
          "type": "object",
          "properties": {
            "broadcast": {
              "type": "string",
              "description": "发现地址 host:port。默认 255.255.255.255:41953。"
            },
            "peers": {
              "type": "array",
              "maxItems": 32,
              "items": {
                "type": "string",
                "description": "单播 HELLO 目标，host:port 形式。"
              }
            },
            "hello_interval": {
              "$ref": "#/$defs/duration",
              "description": "HELLO 间隔。默认 3s。"
            },
            "node_ttl": {
              "$ref": "#/$defs/duration",
              "description": "对端过期时间。默认 9s。"
            }
          },
          "additionalProperties": true
        },
        "routes": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "object",
            "required": ["service", "endpoint"],
            "properties": {
              "service": {
                "type": "string",
                "maxLength": 63
              },
              "endpoint": {
                "type": "string",
                "maxLength": 255,
                "description": "端点 URI，例如 tcp://127.0.0.1:42420。"
              }
            },
            "additionalProperties": true
          },
          "description": "绕过发现流程的静态服务路由。"
        }
      },
      "additionalProperties": true
    },
    "pubsub": {
      "type": "object",
      "properties": {
        "backends": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "oneOf": [
              {
                "type": "string",
                "maxLength": 255,
                "description": "后端端点 URI，例如 dds://0、rtps://0、shm://orders:1。"
              },
              {
                "type": "object",
                "required": ["endpoint"],
                "properties": {
                  "endpoint": {
                    "type": "string",
                    "maxLength": 255
                  },
                  "qos": {
                    "$ref": "#/$defs/qos"
                  },
                  "intra_process": {
                    "type": "string",
                    "enum": ["off", "auto", "only"],
                    "description": "DDS 事件的进程内快路径。"
                  },
                  "poll_us": {
                    "type": "integer",
                    "minimum": 0,
                    "description": "shm 排空本地队列后的忙轮询窗口（微秒）。"
                  }
                },
                "additionalProperties": true
              }
            ]
          },
          "description": "发布/订阅后端；participant/topic 在运行期创建。"
        },
        "default_qos": {
          "$ref": "#/$defs/qos",
          "description": "binding 的 qos 为 INHERIT 时使用的默认 QoS。"
        }
      },
      "additionalProperties": true
    },
    "metrics": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "是否采集指标。默认 true。"
        },
        "latency_histogram": {
          "type": "boolean",
          "description": "是否采集延迟直方图。默认 true。"
        },
        "sample_every": {
          "type": "integer",
          "minimum": 0,
          "description": "延迟采样间隔。0 或 1 表示每次调用都采样。"
        }
      },
      "additionalProperties": true
    },
    "log": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "是否输出日志。默认 true。"
        },
        "level": {
          "type": "string",
          "enum": ["assert", "error", "warn", "info", "debug", "verbose"],
          "description": "日志级别。默认：info。"
        }
      },
      "additionalProperties": true
    }
  },
  "$defs": {
    "duration": {
      "oneOf": [
        {
          "type": "integer",
          "minimum": 0,
          "description": "毫秒数。"
        },
        {
          "type": "string",
          "pattern": "^[0-9]+(ms|s)$",
          "description": "带单位的时长，例如 250ms、2s。"
        }
      ]
    },
    "qos": {
      "type": "object",
      "properties": {
        "reliability": {
          "type": "string",
          "enum": ["best_effort", "reliable"],
          "description": "DDS ReliabilityQosPolicy。"
        },
        "durability": {
          "type": "string",
          "enum": ["volatile", "transient_local"],
          "description": "DDS DurabilityQosPolicy。"
        },
        "history": {
          "type": "string",
          "enum": ["keep_last", "keep_all"],
          "description": "DDS HistoryQosPolicy。"
        },
        "depth": {
          "type": "integer",
          "minimum": 0,
          "description": "keep_last 的 history 深度。0 使用 provider 默认值。"
        },
        "deadline": {
          "$ref": "#/$defs/duration",
          "description": "DDS DeadlineQosPolicy。"
        },
        "lifespan": {
          "$ref": "#/$defs/duration",
          "description": "DDS LifespanQosPolicy。"
        },
        "latency_budget": {
          "$ref": "#/$defs/duration",
          "description": "DDS LatencyBudgetQosPolicy。"
        },
        "min_separation": {
          "$ref": "#/$defs/duration",
          "description": "DDS TimeBasedFilterQosPolicy 的最小间隔。"
        },
        "liveliness": {
          "type": "string",
          "enum": ["automatic", "manual_by_participant", "manual_by_topic"],
          "description": "DDS LivelinessQosPolicy 类型。"
        },
        "lease_duration": {
          "$ref": "#/$defs/duration",
          "description": "DDS LivelinessQosPolicy 的租约时长。"
        },
        "ownership": {
          "type": "string",
          "enum": ["shared", "exclusive"],
          "description": "DDS OwnershipQosPolicy。"
        },
        "partition": {
          "type": "string",
          "maxLength": 127,
          "description": "DDS PartitionQosPolicy（单个 partition 名称）。"
        },
        "max_samples": {
          "type": "integer",
          "minimum": 0,
          "description": "DDS ResourceLimitsQosPolicy 的 max_samples；0 表示不限制。"
        },
        "max_instances": {
          "type": "integer",
          "minimum": 0,
          "description": "DDS ResourceLimitsQosPolicy 的 max_instances；0 表示内建上限。"
        },
        "max_samples_per_instance": {
          "type": "integer",
          "minimum": 0,
          "description": "DDS ResourceLimitsQosPolicy 的 max_samples_per_instance；0 表示不限制。"
        },
        "autodispose_unregistered": {
          "type": "boolean",
          "description": "DDS WriterDataLifecycleQosPolicy；writer 注销时 dispose 其所有实例。"
        },
        "presentation_scope": {
          "type": "string",
          "enum": ["instance", "topic", "group"],
          "description": "DDS PresentationQosPolicy 访问范围。"
        },
        "coherent_access": {
          "type": "boolean",
          "description": "DDS PresentationQosPolicy coherent_access。"
        },
        "ordered_access": {
          "type": "boolean",
          "description": "DDS PresentationQosPolicy ordered_access。"
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
